{
  "name": "@haneoka/altair-plugin-vega-preview",
  "version": "0.1.0",
  "description": "Official Altair API v2 compiler, preview provider, and service for Vega",
  "keywords": [
    "visual-novel",
    "altair",
    "vega",
    "preview",
    "compiler"
  ],
  "license": "MPL-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/haneoka-gakuen/altair-plugin-vega-preview.git"
  },
  "bugs": {
    "url": "https://github.com/haneoka-gakuen/altair-plugin-vega-preview/issues"
  },
  "homepage": "https://github.com/haneoka-gakuen/altair-plugin-vega-preview#readme",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "docs",
    "LICENSE",
    "LICENSE-SCOPE.md",
    "README.md",
    "SECURITY.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./compiler": {
      "types": "./dist/compiler.d.ts",
      "import": "./dist/compiler.js",
      "default": "./dist/compiler.js"
    },
    "./preview": {
      "types": "./dist/preview.d.ts",
      "import": "./dist/preview.js",
      "default": "./dist/preview.js"
    },
    "./projection": {
      "types": "./dist/projection.d.ts",
      "import": "./dist/projection.js",
      "default": "./dist/projection.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "verify:package": "node scripts/verify-package.mjs",
    "check": "pnpm run typecheck && pnpm run build && pnpm run verify:package",
    "prepack": "pnpm run check"
  },
  "peerDependencies": {
    "@haneoka/altair": "^0.1.0",
    "@haneoka/altair-plugin-adv": "^0.1.0",
    "@haneoka/altair-preview-client": "^0.1.0",
    "@haneoka/vega": "^0.1.0",
    "@haneoka/vega-protocol": "^0.1.0"
  },
  "devDependencies": {
    "@haneoka/altair": "^0.1.0",
    "@haneoka/altair-plugin-adv": "^0.1.0",
    "@haneoka/altair-preview-client": "^0.1.0",
    "@haneoka/vega": "^0.1.0",
    "@haneoka/vega-protocol": "^0.1.0",
    "@types/node": "^26.1.0",
    "typescript": "^6.0.3",
    "vite": "^7.3.6"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.14.0",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "altair": {
    "pluginApi": 2,
    "dependencies": {
      "haneoka.altair-adv": "^0.1.0"
    },
    "capabilities": [
      "compiler",
      "preview",
      "services"
    ]
  }
}
